@{
    ViewData["Title"] = "Orders";
 
 }

<div>
  <h1>Velkommen til PackMan-Orders</h1>
</div>

<div>
    <table class="table">

        <thead>
            <th>Id</th>
            <th>Reference ordrenummer</th>
            <th>Actions</th> 
        </thead>

        <tbody>
            @foreach (var Order in Model)
            {
                <tr>
                    <td>@Order.TransportOrderId</td>
                    <td>@Order.RefOrderId</td>
                    <td>
                       
                        <a asp-action="PackingGuide" asp-route-id="@Order.TransportOrderId" class="btn btn-primary btn-lg">Pak</a>
                    </td>
                </tr>
            }

        </tbody>

    </table>
</div>

